{
  "name": "dontsuckatfantasydrafts",
  "version": "1.0.0",
  "description": "BLITZ — Boards, Lineups, Insights, Tools, & Zero-suck",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build:server && npm run build:client",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "type-check": "npm run type-check --prefix server && npm run type-check --prefix client",
    "test": "npm run test --prefix server",
    "research:sot": "tsx scripts/research/run.ts",
    "enrichment:refresh": "tsx scripts/enrichment/refresh.ts",
    "enrichment:weekly": "tsx scripts/enrichment/weekly.ts",
    "enrichment:import-rankings": "tsx scripts/enrichment/import-rankings.ts",
    "enrichment:fetch-espn-ranks": "tsx scripts/enrichment/fetch-espn-ranks.ts",
    "enrichment:fetch-player-status": "tsx scripts/enrichment/fetch-player-status.ts",
    "enrichment:fetch-espn-oprk": "tsx scripts/enrichment/fetch-espn-oprk.ts",
    "enrichment:fetch-sleeper-oprk": "tsx scripts/enrichment/fetch-sleeper-oprk.ts",
    "enrichment:fetch-cbs-oprk": "tsx scripts/enrichment/fetch-cbs-oprk.ts",
    "enrichment:fetch-platform-player-ranks": "tsx scripts/enrichment/fetch-platform-player-ranks.ts",
    "enrichment:fetch-espn-week-scoring": "tsx scripts/enrichment/fetch-espn-week-scoring.ts",
    "enrichment:fetch-poolgenius": "tsx scripts/enrichment/fetch-poolgenius.ts",
    "enrichment:fetch-sos-schedule": "tsx scripts/enrichment/fetch-sos-schedule.ts",
    "enrichment:fetch-game-context": "tsx scripts/enrichment/fetch-game-context.ts",
    "enrichment:build-consensus": "tsx scripts/enrichment/build-consensus.ts",
    "enrichment:apply-projections": "tsx scripts/enrichment/apply-clay-projections.ts",
    "enrichment:import-fantasy-points": "tsx scripts/enrichment/import-fantasy-points.ts",
    "enrichment:fetch-player-usage": "tsx scripts/enrichment/fetch-player-usage.ts",
    "enrichment:fetch-oline-ranks": "tsx scripts/enrichment/fetch-oline-ranks.ts",
    "enrichment:import-draft-picks": "tsx scripts/enrichment/import-draft-picks.ts",
    "enrichment:build-td-matchups": "tsx scripts/enrichment/build-td-matchups.ts"
  },
  "devDependencies": {
    "@cursor/sdk": "^1.0.28",
    "concurrently": "^9.1.2",
    "dotenv": "^16.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
